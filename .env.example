# Copy to .env.local for local `vercel dev`. Set the same names in Vercel → Project → Settings → Environment Variables.
# NEVER prefix the Gemini key with VITE_ — Vite inlines VITE_* variables into the public JavaScript bundle.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional
# ALLOWED_ORIGINS=https://epic-hertz-studio.vercel.app,https://saikrishna-bethamcharla.github.io,http://localhost:5173
# MAX_AUDIO_BYTES=4400000
# RATE_LIMIT_PER_MIN=8
# RATE_LIMIT_PER_DAY=60
# GLOBAL_DAILY_LIMIT=500
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite

# Strongly recommended in production: a shared rate-limit store (free Upstash Redis database).
# Without it, limits are per serverless instance and easy to sidestep.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
